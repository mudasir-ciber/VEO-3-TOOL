{
  "manifest_version": 3,
  "name": "Chained Evolution Studio (VEO 3)",
  "version": "3.0.0",
  "description": "Complete in-browser automation studio for Google Flow continuous video generation chains.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "studio.html",
  "side_panel": {
    "default_path": "studio.html"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
